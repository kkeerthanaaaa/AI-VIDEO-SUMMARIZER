# ============================================
# AI Video Summarizer - Frontend Environment
# ============================================
# Copy this file to ".env" (for local dev) and/or configure these
# as environment variables in your Vercel project settings.

# Base URL of the backend API.
# - Local development: leave empty to use the Vite dev proxy (see vite.config.ts)
# - Production: set to your deployed backend URL, e.g. https://your-api.onrender.com
VITE_API_BASE_URL=

# Maximum video upload size in MB (should match the backend's MAX_FILE_SIZE_BYTES)
VITE_MAX_FILE_SIZE_MB=200
