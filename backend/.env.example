# ============================================
# AI Video Summarizer - Backend Environment
# ============================================
# Copy this file to ".env" and fill in your values.
# NEVER commit your real .env file to version control.

# ---- Server ----
PORT=5000
NODE_ENV=development

# Comma separated list of allowed origins for CORS.
# Example for local dev: http://localhost:5173
# Example for production: https://your-frontend.vercel.app
CORS_ORIGIN=http://localhost:5173

# ---- Gemini API ----
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model used for video understanding.
# gemini-2.0-flash is fast & cost-effective and supports video input.
GEMINI_MODEL=gemini-2.0-flash

# ---- Uploads ----
# Maximum upload size in bytes (default: 200MB)
MAX_FILE_SIZE_BYTES=209715200

# Directory used for temporary file storage before upload to Gemini
UPLOAD_DIR=uploads

# ---- Rate Limiting ----
# Time window in minutes
RATE_LIMIT_WINDOW_MINUTES=15
# Max number of /api/video/process requests per window per IP
RATE_LIMIT_MAX_REQUESTS=20

# ---- Cache ----
# How long generated summaries stay cached (in seconds). Default: 24 hours
CACHE_TTL_SECONDS=86400

# ---- Job store ----
# How long completed/failed jobs stay in memory before cleanup (in seconds)
JOB_TTL_SECONDS=3600
